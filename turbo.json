{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "REDIS_URL",
    "NVIDIA_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "generate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate"]
    }
  }
}
