# ---- App ----
NODE_ENV=development
APP_NAME=Tailor
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
LOG_LEVEL=info

# ---- Data ----
DATABASE_URL=postgresql://tailor:tailor@localhost:5432/tailor
DATABASE_URL_TEST=postgresql://tailor:tailor@localhost:5432/tailor_test
REDIS_URL=redis://localhost:6379

# ---- Email (dev: Mailpit SMTP on 1025; prod: SES SMTP interface) ----
# EMAIL_TRANSPORT=log prints OTP codes to the API console instead of sending (dev only)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SES_FROM=Tailor <no-reply@tailor.local>
AWS_REGION=ap-south-1

# ---- File storage ----
# disk = temporary local folder for development (files deleted after FILE_RETENTION_HOURS)
# s3   = S3-compatible storage (Cloudflare R2), required in production
STORAGE_DRIVER=disk
STORAGE_DISK_DIR=.local-storage
FILE_RETENTION_HOURS=24
# R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_MAX_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=600

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-access-secret-at-least-32-chars
REFRESH_SECRET=change-me-dev-only-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=admin@tailor.local
AUTH_RATE_LIMIT_PER_MIN=5
OTP_REQUESTS_PER_EMAIL_PER_HOUR=5
API_RATE_LIMIT_PER_MIN=120
VAULT_BUILDS_PER_HOUR=10
JOBS_PER_HOUR=30
ANON_CHECKS_PER_IP_PER_DAY=10
ANON_SESSION_TTL_HOURS=72
CORS_ORIGINS=

# ---- Bot protection / billing (later phases) ----
# Cloudflare test keys (always pass) for development; use real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMPANY_GSTIN=

# ---- AI ----
AI_PROVIDER_PRIMARY=nvidia
AI_PROVIDER_FALLBACK=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
# Verified against https://integrate.api.nvidia.com/v1/models on 2026-10-09
AI_MODEL_STANDARD=nvidia/nemotron-3-super-120b-a12b
AI_MODEL_PREMIUM=nvidia/nemotron-3-ultra-550b-a55b
# Model used when the fallback provider takes over (provider-specific id)
AI_FALLBACK_MODEL_STANDARD=
AI_FALLBACK_MODEL_PREMIUM=
AI_TASK_OVERRIDES={}
AI_RPM_LIMIT=35
# Bucket capacity; worst case per minute = AI_RPM_LIMIT + AI_RPM_BURST (keep under provider limit ~40)
AI_RPM_BURST=3
AI_TIMEOUT_MS=45000
AI_DEBUG_LOG=false

# ---- Observability ----
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
