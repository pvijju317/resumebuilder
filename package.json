{
  "name": "tailor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tailor/web --filter=@tailor/api --filter=@tailor/worker",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && bash scripts/check-todos.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @tailor/db run migrate",
    "db:deploy": "pnpm --filter @tailor/db run migrate:deploy",
    "db:seed": "pnpm --filter @tailor/db run seed",
    "db:generate": "pnpm --filter @tailor/db run generate",
    "eval": "pnpm --filter @tailor/ai --silent run eval",
    "fixtures:resumes": "tsx evals/resumes/generate.ts",
    "eval:parse": "pnpm --filter @tailor/api --silent run eval:parse",
    "vercel:build": "node scripts/vercel-build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "docx": "9.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
